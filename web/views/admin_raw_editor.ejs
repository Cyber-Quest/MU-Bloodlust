<%- include('partials/header') %>

<style>
  .raw-text {
    width: 100%;
    min-height: 60vh;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Courier New", monospace;
    font-size: 0.85rem;
    line-height: 1.45;
    padding: 12px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    background: #0e1420;
    color: #e6edf3;
    resize: vertical;
    white-space: pre;
    overflow: auto;
    tab-size: 4;
  }
  .cfg-dirty.dirty {
    color: var(--danger, #c0392b);
    font-weight: 600;
  }
</style>

<section class="card">
  <div class="row-between">
    <h2><%= title %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/server-editor">Editor do servidor</a>
      <a class="button-link" href="/admin/accounts">Contas</a>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (!editorEnabled) { %>
    <div class="alert">
      O editor do servidor está desabilitado. Para ativá-lo, inicie o stack com
      <code>EDITOR_ENABLED=1</code> e o compose do editor.
    </div>
  <% } else { %>
    <% if (typeof hint !== 'undefined' && hint) { %>
      <p class="muted"><%= hint %></p>
    <% } %>
    <div
      id="raw-editor"
      data-api-get="/admin/server-editor/api/config?kind=<%= kind %>"
      data-api-post="/admin/server-editor/api/config?kind=<%= kind %>"
      data-reload="<%= reload %>"></div>
  <% } %>
</section>

<% if (editorEnabled) { %>
<script src="/js/raw-editor.js"></script>
<% } %>

<%- include('partials/footer') %>
