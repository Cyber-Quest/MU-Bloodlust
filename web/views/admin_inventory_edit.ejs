<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Inventário - <%= charName %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts/<%= accountId %>">Conta</a>
      <a class="button-link" href="/admin/accounts">Contas</a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <% if (!offline) { %>
    <div class="alert">A conta está online. Desconecte-a para salvar alterações.</div>
  <% } %>

  <div id="inventory-editor"
       data-mode="inventory"
       data-account="<%= accountId %>"
       data-character="<%= charName %>"
       data-hex="<%= inventoryHex %>">
  </div>

  <form method="post" action="/admin/accounts/<%= accountId %>/characters/<%= encodeURIComponent(charName) %>/inventory">
    <input type="hidden" name="inventory_hex" id="inventory-hex" value="<%= inventoryHex %>" />
    <div class="row-between">
      <button type="submit">Salvar inventário</button>
      <a class="button-link" href="/admin/accounts/<%= accountId %>/characters/<%= encodeURIComponent(charName) %>">Voltar</a>
    </div>
  </form>
</section>

<script src="/js/inventory-editor.js"></script>

<%- include('partials/footer') %>


