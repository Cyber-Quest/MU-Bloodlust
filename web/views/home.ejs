<%- include('partials/site_head', { pageTitle, page }) %>

<main class="flex-grow-1">
  <div class="container">
    <section class="mu-hero">
      <img src="/assets/images/icon.png" width="132" height="99" alt="<%= appName %>" class="mu-hero-emblem">
      <h1 class="mu-hero-title"><%= appName %></h1>
      <p class="mu-hero-sub">Servidor MU Online 0.97k &bull; Servidor aberto para todos</p>

      <div class="mu-hero-actions">
        <a class="btn btn-primary" href="/download"><i class="bi bi-download me-2"></i>Baixar o jogo</a>
        <% if (session && session.user) { %>
          <a class="btn btn-outline-primary" href="/account"><i class="bi bi-person-circle me-2"></i>Minha conta</a>
        <% } else { %>
          <a class="btn btn-outline-primary" href="/register"><i class="bi bi-person-plus me-2"></i>Criar conta</a>
        <% } %>
        <a class="btn btn-outline-primary" href="/rankings"><i class="bi bi-trophy me-2"></i>Ver rankings</a>
      </div>

      <div class="mu-stat-row">
        <div class="mu-stat">
          <span class="mu-stat-label">Jogadores online</span>
          <span class="mu-stat-value is-online" id="players-online"><%= playersOnline %></span>
        </div>
        <div class="mu-stat">
          <span class="mu-stat-label">Hora do servidor</span>
          <span class="mu-stat-value" id="server-time" data-tz="<%= timeZone || '' %>"><%= serverTime %></span>
        </div>
        <div class="mu-stat">
          <span class="mu-stat-label">Sua hora</span>
          <span class="mu-stat-value" id="user-time">--:--:--</span>
        </div>
      </div>
    </section>
  </div>

  <div class="container my-5">
    <div class="p-4 bg-light shadow-lg rounded-4">
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="bg-white border p-4 shadow-sm rounded-3 h-100">
            <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Últimas notícias</h2>

            <% if (!news || news.length === 0) { %>
              <div class="news-item mb-4 p-4 rounded-3">
                <p class="text-muted mb-0">Ainda não há notícias publicadas.</p>
              </div>
            <% } else { %>
              <% news.forEach(function(item) { %>
                <% const hasImage = item.featuredImage && item.featuredImage.length > 0; %>
                <% const hasText = item.excerpt && item.excerpt.trim().length > 0; %>
                <div class="news-item mb-4 p-4 rounded-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fs-6"><%= new Date(item.created_at).toLocaleDateString('pt-BR') %></span>
                    <span class="badge text-bg-primary">Notícia</span>
                  </div>
                  <div class="news-body <%= hasImage && hasText ? 'news-body--thumb' : '' %>">
                    <% if (hasImage) { %>
                      <div class="<%= hasText ? 'news-thumb' : 'news-banner' %>">
                        <img src="<%= item.featuredImage %>" alt="<%= item.title %>" loading="lazy" />
                      </div>
                    <% } %>
                    <div class="news-text">
                      <% if (!item.hide_title) { %>
                        <h5 class="news-title fs-5 fw-bold mb-2"><%= item.title %></h5>
                      <% } %>
                      <% if (hasText) { %>
                        <p class="news-description mb-3"><%= item.excerpt %></p>
                      <% } %>
                      <a href="/news/<%= item.id %>" class="fs-6">Ler mais &rarr;</a>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

        <div class="col-12 col-lg-4">
          <div class="bg-white border p-4 shadow-sm rounded-3 mb-4">
            <% if (session && session.user) { %>
              <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Sessão</h2>
              <p class="text-center mb-3 text-muted">Conta: <strong><%= session.user.id %></strong></p>
              <div class="d-grid gap-2">
                <a class="btn btn-primary" href="/account">Ver conta</a>
                <a class="btn btn-outline-secondary" href="/logout">Sair</a>
              </div>
            <% } else { %>
              <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Entrar</h2>
              <form action="/login" method="POST">
                <div class="mb-3">
                  <input type="text" class="form-control" name="account" placeholder="Usuário" required>
                </div>
                <div class="mb-3">
                  <input type="password" class="form-control" name="password" placeholder="Senha" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
              </form>
              <div class="text-center mt-3">
                <a href="/register">Criar conta</a>
              </div>
            <% } %>
          </div>

          <div class="bg-white p-4 border rounded-3 shadow-sm mb-4">
            <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Top 10</h2>
            <div class="table-responsive">
              <table class="table table-bordered table-striped mb-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>GR</th>
                    <th>Reset</th>
                    <th>Nível</th>
                    <th>Classe</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!ranking || ranking.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center">Sem dados</td>
                    </tr>
                  <% } else { %>
                    <% ranking.forEach(function(row, idx) { %>
                      <tr>
                        <td><%= idx + 1 %></td>
                        <td><%= row.Name %></td>
                        <td><%= row.GrandResetCount %></td>
                        <td><%= row.ResetCount %></td>
                        <td><%= row.cLevel %></td>
                        <td class="text-center">
                          <img src="<%= row.ClassIcon %>" alt="<%= row.ClassName %>" title="<%= row.ClassName %>" class="class-icon" />
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-white p-4 border rounded-3 shadow-sm">
            <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Próximos eventos</h2>
            <div class="table-responsive">
              <table class="table table-bordered table-striped mb-0">
                <thead>
                  <tr>
                    <th>Evento</th>
                    <th>Próxima hora</th>
                    <th>Faltam</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!events || events.length === 0) { %>
                    <tr>
                      <td colspan="3" class="text-center">Sem dados</td>
                    </tr>
                  <% } else { %>
                    <% events.forEach(function(ev) { %>
                      <tr>
                        <td><%= ev.name %></td>
                        <td><%= ev.nextTime %></td>
                        <td>
                          <span class="event-countdown" data-countdown="<%= ev.nextAt %>"><%= ev.remainingSeconds %></span>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/site_footer') %>
