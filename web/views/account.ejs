<%- include('partials/site_head', { pageTitle, page }) %>

<main class="flex-grow-1">
  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-6">
        <div class="bg-white border p-4 shadow-sm rounded-4">
          <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Minha conta</h2>
          <% if (notice) { %>
            <div class="alert alert-success"><%= notice.text %></div>
          <% } %>
          <% if (error) { %>
            <div class="alert alert-danger"><%= error.text %></div>
          <% } %>
          <table class="table table-bordered mb-0">
            <tbody>
              <tr>
                <th>Usuário</th>
                <td><%= account?.memb___id %></td>
              </tr>
              <tr>
                <th>Nome</th>
                <td><%= account?.memb_name %></td>
              </tr>
              <tr>
                <th>E-mail</th>
                <td><%= account?.mail_addr || '-' %></td>
              </tr>
              <tr>
                <th>Nível da conta</th>
                <td><%= account?.AccountLevel %></td>
              </tr>
            </tbody>
          </table>
          <div class="d-grid mt-3">
            <a class="btn btn-outline-secondary" href="/logout">Sair</a>
          </div>
        </div>

        <div class="bg-white border p-4 shadow-sm rounded-4 mt-4">
          <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Personagens</h2>
          <p class="text-muted small">As ações só funcionam se a conta estiver desconectada. Cooldown: 30 min por personagem e ação.</p>
          <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>Nível</th>
                  <th>Classe</th>
                  <th>Mapa</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (!characters || characters.length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center">Sem personagens</td>
                  </tr>
                <% } else { %>
                  <% characters.forEach(function(char) { %>
                    <tr>
                      <td><%= char.Name %></td>
                      <td><%= char.cLevel %></td>
                      <td class="text-center">
                        <img src="<%= char.ClassIcon %>" alt="<%= char.ClassName %>" title="<%= char.ClassName %>" class="class-icon" />
                      </td>
                      <td title="Mapa <%= char.MapNumber %>"><%= char.MapName %></td>
                      <td>
                        <div class="d-flex flex-wrap gap-2">
                          <a class="btn btn-sm btn-primary" href="/account/character/<%= encodeURIComponent(char.Name) %>">Ver perfil</a>
                          <form method="post" action="/account/character/<%= encodeURIComponent(char.Name) %>/move-home">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Mover para zona segura</button>
                          </form>
                          <form method="post" action="/account/character/<%= encodeURIComponent(char.Name) %>/clear-inventory" onsubmit="return confirm('Tem certeza de que deseja limpar o inventário deste personagem?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Limpar inventário</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/site_footer') %>
