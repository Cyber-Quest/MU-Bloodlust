<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Editor de portais</h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/server-editor">Editor do servidor</a>
      <a class="button-link" href="/admin/accounts">Contas</a>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (!editorEnabled) { %>
    <div class="alert">
      O editor do servidor está desabilitado. Para ativá-lo, inicie o stack com
      <code>EDITOR_ENABLED=1</code> e o compose do editor.
    </div>
  <% } else { %>
    <div id="gate-editor"></div>
    <div class="alert warning" style="margin-top: 12px;">
      Nota: os portais adicionados no servidor devem ser adicionados também no cliente
      (<code>Gate.bmd</code>/<code>Gate.txt</code>) para que funcionem. No repo original
      do Kayito há um editor de <strong>BMD</strong>.
    </div>
  <% } %>
</section>

<% if (editorEnabled) { %>
<script src="/js/gates-editor.js"></script>
<% } %>

<%- include('partials/footer') %>


