<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Downloads</h2>
    <div class="admin-links">
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/accounts">Contas</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <div class="card-sub">
    <h3>Links públicos</h3>
    <p class="muted">Use URLs externas (MediaFire, Drive, R2) ou caminhos locais como <code>/downloads/cliente.zip</code>.</p>
    <form method="post" action="/admin/downloads">
      <label for="client_url">Cliente completo (URL)</label>
      <input id="client_url" name="client_url" type="text" value="<%= config.clientUrl %>" placeholder="https://... ou /downloads/cliente.zip" />

      <label for="client_subtitle">Descrição do cliente</label>
      <input id="client_subtitle" name="client_subtitle" type="text" value="<%= config.clientSubtitle %>" placeholder="Ex: Inclui tudo para jogar." />

      <label for="patch_url">Patches / atualizações manuais (URL)</label>
      <input id="patch_url" name="patch_url" type="text" value="<%= config.patchUrl %>" placeholder="https://... ou /downloads/updates.zip" />

      <label for="patch_subtitle">Descrição do patch</label>
      <input id="patch_subtitle" name="patch_subtitle" type="text" value="<%= config.patchSubtitle %>" placeholder="Ex: Glow rosa Grand Soul." />

      <div class="actions">
        <button type="submit">Salvar</button>
      </div>
    </form>
  </div>

  <div class="card-sub">
    <h3>Arquivos locais detectados</h3>
    <p class="muted">Coloque os arquivos em <code>web/public/downloads</code> para servi-los a partir do contêiner.</p>

    <h4>Downloads</h4>
    <ul class="list">
      <% if (!files.downloads.length) { %>
        <li><span class="muted">Sem arquivos em downloads.</span></li>
      <% } else { %>
        <% files.downloads.forEach((file) => { %>
          <li>
            <span><code><%= file.name %></code></span>
            <span class="meta"><%= file.sizeLabel %></span>
          </li>
        <% }) %>
      <% } %>
    </ul>
  </div>
</section>

<%- include('partials/footer') %>
