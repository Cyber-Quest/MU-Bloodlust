<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Contas</h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts/new">Nova conta</a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <form method="get" action="/admin/accounts">
    <label>Buscar (usuário, nome ou e-mail)</label>
    <input type="text" name="q" value="<%= q %>" maxlength="50" />
    <button type="submit">Buscar</button>
  </form>

  <% if (accounts.length === 0) { %>
    <p class="muted">Não há contas para exibir.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Usuário</th>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Nível</th>
          <th>Status</th>
          <th>Online</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% accounts.forEach(item => { %>
          <tr>
            <td><%= item.memb___id %></td>
            <td><%= item.memb_name %></td>
            <td><%= item.mail_addr || '-' %></td>
            <td><%= item.AccountLevel %></td>
            <td><%= String(item.bloc_code) === '1' ? 'Bloqueado' : 'OK' %></td>
            <td><%= item.ConnectStat === 1 ? 'Online' : 'Offline' %></td>
            <td class="actions">
              <a href="/admin/accounts/<%= item.memb___id %>">Editar</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>


