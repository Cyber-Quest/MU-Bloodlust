<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Editor do servidor</h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts">Contas</a>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (!editorEnabled) { %>
    <div class="alert">
      O editor do servidor está desabilitado. Para ativá-lo, inicie o stack com
      <code>EDITOR_ENABLED=1</code> e o compose do editor.
    </div>
  <% } else { %>
    <div class="alert success">
      Editor habilitado. API: <code><%= editorApiUrl %></code>
    </div>

    <div class="card-sub">
      <h3>Editor de lojas</h3>
      <p class="muted">Edita os arquivos <code>MuServer/Data/Shop</code> com grid gráfico.</p>
      <a class="button-link" href="/admin/server-editor/shops">Abrir editor de lojas</a>
    </div>

    <div class="card-sub">
      <h3>Editor de spawns</h3>
      <p class="muted">Edita <code>MonsterSetBase.txt</code> com mapa e posições.</p>
      <a class="button-link" href="/admin/server-editor/spawns">Abrir editor de spawns</a>
    </div>

    <div class="card-sub">
      <h3>Editor de monstros</h3>
      <p class="muted">Edita <code>Monster.txt</code> (HP, dano, exp, etc).</p>
      <a class="button-link" href="/admin/server-editor/monsters">Abrir editor de monstros</a>
    </div>

    <div class="card-sub">
      <h3>Editor de portais</h3>
      <p class="muted">Edita <code>Gate.txt</code> com mapa e retângulos.</p>
      <a class="button-link" href="/admin/server-editor/gates">Abrir editor de portais</a>
    </div>

    <div class="card-sub">
      <h3>Editor de movimentações</h3>
      <p class="muted">Edita <code>Move.txt</code> (lista do botão M).</p>
      <a class="button-link" href="/admin/server-editor/moves">Abrir editor de movimentações</a>
    </div>

    <div class="card-sub">
      <h3>Customs</h3>
      <p class="muted">
        Edita <code>CustomSafeZone.txt</code>, <code>CustomPkFree.txt</code> e <code>CustomNpcMove.txt</code>.
      </p>
      <a class="button-link" href="/admin/server-editor/customs">Abrir customs</a>
    </div>

    <div class="card-sub">
      <h3>Editor de itens base</h3>
      <p class="muted">Edita <code>Item.txt</code>, <code>ItemValue.txt</code> e <code>ItemStack.txt</code>.</p>
      <a class="button-link" href="/admin/server-editor/items">Abrir editor de itens</a>
    </div>

    <div class="card-sub">
      <h3>Editor de drop</h3>
      <p class="muted">Edita <code>ItemDrop.txt</code> (drops especiais por mapa/monstro).</p>
      <a class="button-link" href="/admin/server-editor/drop">Abrir editor de drop</a>
    </div>

    <div class="card-sub">
      <h3>Editor de reset/exp</h3>
      <p class="muted">Edita <code>ResetTable.txt</code> e <code>ExperienceTable.txt</code>.</p>
      <a class="button-link" href="/admin/server-editor/reset-exp">Abrir editor de reset/exp</a>
    </div>

    <div class="card-sub">
      <h3>Editor de mapas</h3>
      <p class="muted">Edita <code>MapManager.txt</code> (índices e taxas de mapas).</p>
      <a class="button-link" href="/admin/server-editor/mapmanager">Abrir editor de mapas</a>
    </div>

    <div class="card-sub">
      <h3>Editor de GM</h3>
      <p class="muted">Edita <code>GameMaster.txt</code> com níveis por personagem.</p>
      <a class="button-link" href="/admin/server-editor/gms">Abrir editor de GM</a>
    </div>

    <div class="card-sub">
      <h3>Editor de avisos</h3>
      <p class="muted">Edita <code>Notice.txt</code> (mensagens automáticas).</p>
      <a class="button-link" href="/admin/server-editor/notices">Abrir editor de avisos</a>
    </div>

    <div class="card-sub">
      <h3>Editor de blacklist</h3>
      <p class="muted">Edita <code>Blacklist.dat</code> (IP e HWID).</p>
      <a class="button-link" href="/admin/server-editor/blacklist">Abrir editor de blacklist</a>
    </div>

    <div class="card-sub">
      <h3>CFG geral</h3>
      <p class="muted">Edita toda a configuração do <code>GameServerInfo - Common.dat</code>.</p>
      <a class="button-link" href="/admin/server-editor/rates">Abrir CFG geral</a>
    </div>

    <div class="card-sub">
      <h3>CFG comandos</h3>
      <p class="muted">Edita <code>GameServerInfo - Command.dat</code>.</p>
      <a class="button-link" href="/admin/server-editor/commands">Abrir CFG comandos</a>
    </div>

    <div class="card-sub">
      <h3>CFG skills</h3>
      <p class="muted">Edita <code>GameServerInfo - Skill.dat</code>.</p>
      <a class="button-link" href="/admin/server-editor/skills">Abrir CFG skills</a>
    </div>

    <div class="card-sub">
      <h3>CFG eventos</h3>
      <p class="muted">Edita <code>GameServerInfo - Event.dat</code>.</p>
      <a class="button-link" href="/admin/server-editor/events">Abrir CFG eventos</a>
    </div>

    <div class="card-sub">
      <h3>CFG chaos mix</h3>
      <p class="muted">Edita <code>GameServerInfo - ChaosMix.dat</code> (máquina do chaos).</p>
      <a class="button-link" href="/admin/server-editor/chaosmix">Abrir CFG chaos mix</a>
    </div>

    <div class="card-sub">
      <h3>CFG inicial (StartUp)</h3>
      <p class="muted">
        Edita <code>GameServerInfo - StartUp.dat</code> (nome do servidor, porta, máximo de
        usuários, versão/serial e endereços internos).
      </p>
      <a class="button-link" href="/admin/server-editor/startup">Abrir CFG inicial</a>
    </div>

    <div class="card-sub">
      <h3>CFG personagem</h3>
      <p class="muted">Edita <code>GameServerInfo - Character.dat</code> (regras de personagem).</p>
      <a class="button-link" href="/admin/server-editor/character">Abrir CFG personagem</a>
    </div>

    <div class="card-sub">
      <h3>CFG Blood Castle</h3>
      <p class="muted">Edita <code>Data/Event/BloodCastle.dat</code> (horários, recompensas e níveis).</p>
      <a class="button-link" href="/admin/server-editor/bloodcastle">Abrir CFG Blood Castle</a>
    </div>

    <div class="card-sub">
      <h3>CFG Devil Square</h3>
      <p class="muted">Edita <code>Data/Event/DevilSquare.dat</code> (horários, recompensas e níveis).</p>
      <a class="button-link" href="/admin/server-editor/devilsquare">Abrir CFG Devil Square</a>
    </div>

    <div class="card-sub">
      <h3>CFG invasões</h3>
      <p class="muted">Edita <code>Data/Event/InvasionManager.dat</code> (invasões e monstros).</p>
      <a class="button-link" href="/admin/server-editor/invasion">Abrir CFG invasões</a>
    </div>

    <div class="card-sub">
      <h3>CFG bônus</h3>
      <p class="muted">Edita <code>Data/Event/BonusManager.dat</code> (eventos de bônus e XP extra).</p>
      <a class="button-link" href="/admin/server-editor/bonus">Abrir CFG bônus</a>
    </div>

    <div class="card-sub">
      <h3>CFG spawn de eventos</h3>
      <p class="muted">Edita <code>Data/Event/EventSpawnMonster.dat</code> (spawns de eventos).</p>
      <a class="button-link" href="/admin/server-editor/eventspawn">Abrir CFG spawn de eventos</a>
    </div>

    <div class="card-sub">
      <h3>CFG Golden Archer / Bingo</h3>
      <p class="muted">Edita <code>Data/Event/GoldenArcherBingo.dat</code> (evento do Arqueiro Dourado).</p>
      <a class="button-link" href="/admin/server-editor/goldenarcher">Abrir CFG Golden Archer / Bingo</a>
    </div>

    <div class="card-sub">
      <h3>Mensagens do servidor</h3>
      <p class="muted">
        Edita <code>Data/Message_Eng.txt</code>, <code>Message_Spn.txt</code> e
        <code>Message_Por.txt</code> (textos exibidos no jogo). Guarde em ANSI/Windows-1252 sem BOM.
      </p>
      <div class="admin-links">
        <a class="button-link" href="/admin/server-editor/message-por">Português</a>
        <a class="button-link" href="/admin/server-editor/message-eng">Inglês</a>
        <a class="button-link" href="/admin/server-editor/message-spn">Espanhol</a>
      </div>
    </div>

    <div class="card-sub">
      <h3>CFG ShopManager</h3>
      <p class="muted">Edita <code>Data/ShopManager.txt</code> (lista de lojas do servidor).</p>
      <a class="button-link" href="/admin/server-editor/shopmanager">Abrir CFG ShopManager</a>
    </div>

    <div class="card-sub">
      <h3>CFG anti-hack (pacotes)</h3>
      <p class="muted">Edita <code>Data/Hack/HackPacketCheck.txt</code> (verificação de pacotes).</p>
      <a class="button-link" href="/admin/server-editor/hackpacket">Abrir CFG anti-hack</a>
    </div>

    <div class="card-sub">
      <h3>Event ItemBag</h3>
      <p class="muted">
        Edita <code>EventItemBagManager.txt</code> e os bags de <code>Data/EventItemBag</code>.
      </p>
      <a class="button-link" href="/admin/server-editor/event-item-bag">Abrir Event ItemBag</a>
    </div>

    <div class="card-sub">
      <h3>Backups do servidor</h3>
      <p class="muted">
        São salvos até <strong><%= editorMaxBackups %></strong> backups por arquivo e
        até <strong><%= editorMaxSnapshots %></strong> snapshots completos.
      </p>

      <div class="backup-actions">
        <label>Nome (opcional)</label>
        <input type="text" id="backupLabel" placeholder="ex: antes-de-spawns" maxlength="40" />
        <button type="button" id="createBackupBtn">Criar backup</button>
      </div>

      <div class="backup-restore">
        <label>Restaurar snapshot</label>
        <select id="backupSelect"></select>
        <button type="button" class="btn-danger" id="restoreBackupBtn">Restaurar</button>
      </div>

      <div id="backupMessage" class="muted"></div>
    </div>

    <div class="card-sub">
      <h3>Notas</h3>
      <ul>
        <li>Restaurar um snapshot sobrescreve <code>Data</code> e <code>GameServer/Data</code> dentro do contêiner.</li>
        <li>Recomendado reiniciar o contêiner do GameServer depois de restaurar.</li>
      </ul>
    </div>
  <% } %>
</section>

<% if (editorEnabled) { %>
<script>
  const messageEl = document.getElementById('backupMessage');
  const selectEl = document.getElementById('backupSelect');
  const labelEl = document.getElementById('backupLabel');
  const createBtn = document.getElementById('createBackupBtn');
  const restoreBtn = document.getElementById('restoreBackupBtn');

  function setMessage(text, isError) {
    messageEl.textContent = text || '';
    messageEl.style.color = isError ? 'var(--danger)' : 'var(--muted)';
  }

  async function loadSnapshots() {
    try {
      const res = await fetch('/admin/server-editor/api/backups');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Não foi possível carregar');
      const snapshots = data.snapshots || [];
      selectEl.innerHTML = '';
      if (snapshots.length === 0) {
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'Não há backups';
        selectEl.appendChild(option);
        restoreBtn.disabled = true;
        return;
      }
      snapshots.forEach((snap) => {
        const option = document.createElement('option');
        option.value = snap.name;
        const sizeKb = Math.round((snap.size || 0) / 1024);
        option.textContent = `${snap.name} (${sizeKb} KB)`;
        selectEl.appendChild(option);
      });
      restoreBtn.disabled = false;
    } catch (err) {
      setMessage(err.message, true);
    }
  }

  createBtn?.addEventListener('click', async () => {
    setMessage('Criando backup...', false);
    try {
      const res = await fetch('/admin/server-editor/api/backups/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label: labelEl.value })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Não foi possível criar');
      setMessage('Backup criado com sucesso.', false);
      await loadSnapshots();
    } catch (err) {
      setMessage(err.message, true);
    }
  });

  restoreBtn?.addEventListener('click', async () => {
    const name = selectEl.value;
    if (!name) return;
    if (!confirm(`Restaurar o snapshot ${name}? Isto sobrescreverá os dados atuais.`)) return;
    setMessage('Restaurando backup...', false);
    try {
      const res = await fetch('/admin/server-editor/api/backups/restore', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Não foi possível restaurar');
      setMessage('Backup restaurado. Reinicie o GameServer.', false);
      await loadSnapshots();
    } catch (err) {
      setMessage(err.message, true);
    }
  });

  loadSnapshots();
</script>
<% } %>

<%- include('partials/footer') %>


