<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2><%= item ? 'Editar notícia' : 'Nova notícia' %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts">Contas</a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>
  <% if (error) { %>
    <div class="alert"><%= error %></div>
  <% } %>
  <form method="post" action="<%= item ? '/admin/news/' + item.id + '/edit' : '/admin/news/new' %>">
    <label>Título</label>
    <input type="text" name="title" value="<%= item ? item.title : '' %>" required maxlength="120" />

    <label>Conteúdo</label>
    <textarea name="body" rows="10" required><%= item ? item.body : '' %></textarea>
    <p class="muted" style="margin-top:6px">
      Se ativar HTML, você pode usar <code>&lt;img&gt;</code> e <code>&lt;iframe&gt;</code> (YouTube/Vimeo).
      Para centralizar imagens, use <code>&lt;img class="img-center"&gt;</code> ou envolva em <code>&lt;p class="center"&gt;...&lt;/p&gt;</code>.
    </p>

    <label class="checkbox">
      <input type="checkbox" name="allow_html" value="1" <%= item ? (item.body_is_html ? 'checked' : '') : '' %> />
      Permitir HTML no conteúdo
    </label>

    <label class="checkbox">
      <input type="checkbox" name="hide_title" value="1" <%= item ? (item.hide_title ? 'checked' : '') : '' %> />
      Ocultar título na notícia
    </label>

    <label class="checkbox">
      <input type="checkbox" name="published" value="1" <%= item ? (item.published ? 'checked' : '') : 'checked' %> />
      Publicar
    </label>

    <div class="row-between">
      <button type="submit">Salvar</button>
      <a class="button-link" href="/admin/news">Voltar</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>


