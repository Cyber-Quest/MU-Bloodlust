<%- include('partials/site_head', { pageTitle, page }) %>

<%
function escapeHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function fmtNumber(value) {
  return Number(value || 0).toLocaleString('pt-BR');
}

/* ------------------------------------------------------------------
   Layout autentico do cliente: mesmas coordenadas da janela do jogo
   ------------------------------------------------------------------ */
var CELL = 25;                                   // 1 celula = 25px (igual ao jogo)
var S = 1;                                       // escala (1 = tamanho real)

var FRAME_W = 237, FRAME_H = 539;                // moldura do inventario/bau
var EQ = { x: 18, y: 55, w: 200, h: 186 };       // painel de equipamento
var BAG = { x: 19, y: 249, w: 200, h: 200 };     // grade do inventario (8x8)
var WH = { x: 19, y: 62, w: 200, h: 375 };       // grade do bau (8x15)

// Posicoes exatas dos 12 slots de equipamento (iguais ao jogo)
var EQUIP_RECTS = [
  { x: 3,   y: 59,  w: 45, h: 70 },  // 0 Arma
  { x: 152, y: 59,  w: 45, h: 70 },  // 1 Escudo
  { x: 78,  y: 5,   w: 45, h: 45 },  // 2 Elmo
  { x: 78,  y: 59,  w: 45, h: 70 },  // 3 Armadura
  { x: 78,  y: 137, w: 45, h: 45 },  // 4 Calca
  { x: 3,   y: 137, w: 45, h: 45 },  // 5 Luvas
  { x: 152, y: 137, w: 45, h: 45 },  // 6 Botas
  { x: 128, y: 5,   w: 70, h: 45 },  // 7 Asas
  { x: 3,   y: 5,   w: 45, h: 45 },  // 8 Pet
  { x: 53,  y: 59,  w: 20, h: 20 },  // 9 Pingente
  { x: 53,  y: 137, w: 20, h: 20 },  // 10 Anel 1
  { x: 128, y: 137, w: 20, h: 20 }   // 11 Anel 2
];

function itemImg(item) {
  return '<img src="/assets/items/' + item.section + '/' + item.index + '.jpg" alt="' +
    escapeHtml(item.name) + '" loading="lazy" ' +
    'onerror="this.onerror=null;this.src=\'/assets/inventory/unknownItem.jpg\';" />';
}
%>

<main class="flex-grow-1">
  <div class="container my-5">

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <a class="btn btn-sm btn-outline-secondary" href="/account">&larr; Minha conta</a>
    </div>

    <!-- Cabecalho do personagem -->
    <div class="bg-white border p-4 shadow-sm rounded-4 mb-4">
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <img src="<%= character.ClassIcon %>" alt="<%= character.ClassName %>" class="class-icon-lg" />
        <div class="me-auto">
          <h3 class="fw-bold mb-0"><%= character.Name %></h3>
          <div class="text-muted"><%= character.ClassName %> &bull; Nível <%= character.cLevel %></div>
        </div>
        <div class="text-end">
          <span class="badge <%= online ? 'bg-success' : 'bg-secondary' %>"><%= online ? 'Online' : 'Offline' %></span>
          <div class="small text-muted mt-1">Mapa: <%= character.MapName %></div>
        </div>
      </div>

      <hr />

      <div class="row text-center g-2">
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Força</div><div class="profile-stat-value"><%= fmtNumber(character.Strength) %></div></div>
        </div>
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Agilidade</div><div class="profile-stat-value"><%= fmtNumber(character.Dexterity) %></div></div>
        </div>
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Vitalidade</div><div class="profile-stat-value"><%= fmtNumber(character.Vitality) %></div></div>
        </div>
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Energia</div><div class="profile-stat-value"><%= fmtNumber(character.Energy) %></div></div>
        </div>
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Resets</div><div class="profile-stat-value"><%= fmtNumber(character.ResetCount) %></div></div>
        </div>
        <div class="col-6 col-md-2">
          <div class="profile-stat"><div class="profile-stat-label">Grand Reset</div><div class="profile-stat-value"><%= fmtNumber(character.GrandResetCount) %></div></div>
        </div>
      </div>
    </div>

    <div class="row g-4 justify-content-center">
      <!-- Equipamento + Inventario (painel identico ao jogo) -->
      <div class="col-12 col-lg-auto">
        <div class="bg-white border p-3 shadow-sm rounded-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold mb-0">Equipamento</h5>
            <span class="text-muted small"><%= inventory.length %> item(ns) na mochila</span>
          </div>

          <div class="mu-panel-scroll">
            <div class="mu-panel" style="width:<%= FRAME_W * S %>px;height:<%= FRAME_H * S %>px;">

              <!-- Painel de equipamento (arte do jogo) -->
              <div class="mu-overlay mu-overlay--equip"
                   style="left:<%= EQ.x * S %>px;top:<%= EQ.y * S %>px;width:<%= EQ.w * S %>px;height:<%= EQ.h * S %>px;"></div>

              <% equipLabels.forEach(function (label, idx) {
                   var r = EQUIP_RECTS[idx];
                   var item = equipmentBySlot[idx]; %>
                <div class="mu-equip-slot"
                     style="left:<%= (EQ.x + r.x) * S %>px;top:<%= (EQ.y + r.y) * S %>px;width:<%= r.w * S %>px;height:<%= r.h * S %>px;"
                     title="<%= label %><%= item ? ' — ' + item.title : '' %>">
                  <% if (item) { %><%- itemImg(item) %><% } %>
                </div>
              <% }); %>

              <!-- Grade da mochila -->
              <div class="mu-overlay mu-overlay--bag"
                   style="left:<%= BAG.x * S %>px;top:<%= BAG.y * S %>px;width:<%= BAG.w * S %>px;height:<%= BAG.h * S %>px;"></div>

              <% inventory.forEach(function (item) { %>
                <div class="mu-item"
                     style="left:<%= (BAG.x + item.x * CELL) * S %>px;top:<%= (BAG.y + item.y * CELL) * S %>px;width:<%= item.width * CELL * S %>px;height:<%= item.height * CELL * S %>px;"
                     title="<%= escapeHtml(item.title) %>">
                  <%- itemImg(item) %>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>

      <!-- Bau (painel identico ao jogo) -->
      <div class="col-12 col-lg-auto">
        <div class="bg-white border p-3 shadow-sm rounded-4">
          <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            <h5 class="fw-bold mb-0">Baú</h5>
            <span class="text-muted small">
              Zen: <strong><%= fmtNumber(warehouseMoney) %></strong>
              &bull; <%= warehouseItems.length %> item(ns)
            </span>
          </div>

          <div class="mu-panel-scroll">
            <div class="mu-panel mu-panel--warehouse" style="width:<%= FRAME_W * S %>px;height:<%= FRAME_H * S %>px;">

              <div class="mu-overlay mu-overlay--warehouse"
                   style="left:<%= WH.x * S %>px;top:<%= WH.y * S %>px;width:<%= WH.w * S %>px;height:<%= WH.h * S %>px;"></div>

              <% warehouseItems.forEach(function (item) { %>
                <div class="mu-item"
                     style="left:<%= (WH.x + item.x * CELL) * S %>px;top:<%= (WH.y + item.y * CELL) * S %>px;width:<%= item.width * CELL * S %>px;height:<%= item.height * CELL * S %>px;"
                     title="<%= escapeHtml(item.title) %>">
                  <%- itemImg(item) %>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('partials/site_footer') %>
