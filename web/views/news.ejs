<%- include('partials/site_head', { pageTitle, page }) %>

<main class="flex-grow-1">
  <div class="container my-5">
    <div class="p-4 bg-light shadow-lg rounded-4">
      <div class="bg-white border p-4 shadow-sm rounded-3">
        <h2 class="mu-section-title"><span class="mu-ornament">&#9670;</span> Notícias</h2>
        <% if (!news || news.length === 0) { %>
          <p class="text-muted">Não há notícias publicadas.</p>
        <% } else { %>
          <% news.forEach(function(item) { %>
            <div class="news-item mb-4 p-4 border rounded-3 shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fs-6"><%= new Date(item.created_at).toLocaleDateString('pt-BR') %></span>
                <span class="badge text-bg-primary rounded-pill px-3 py-2">Notícia</span>
              </div>
              <% if (!item.hide_title) { %>
                <h5 class="news-title text-dark fs-5 fw-bold mb-2"><%= item.title %></h5>
              <% } %>
              <p class="news-description text-muted mb-3"><%= item.excerpt %></p>
              <a href="/news/<%= item.id %>" class="text-decoration-none text-primary fs-6">Ler mais</a>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/site_footer') %>
