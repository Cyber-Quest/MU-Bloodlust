<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Editar conta</h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts">Contas</a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/news">Notícias</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <div class="card" style="margin-top:12px">
    <h3>Status</h3>
    <% if (stat) { %>
      <ul class="list">
        <li><span>Online</span><span><%= stat.ConnectStat === 1 ? 'Sim' : 'Não' %></span></li>
        <li><span>Server</span><span><%= stat.ServerName || '-' %></span></li>
        <li><span>IP</span><span><%= stat.IP || '-' %></span></li>
        <li><span>Conectou</span><span><%= stat.ConnectLocal || '-' %></span></li>
        <li><span>Desconectou</span><span><%= stat.DisconnectLocal || '-' %></span></li>
      </ul>
    <% } else { %>
      <p class="muted">Sem dados de conexão.</p>
    <% } %>
  </div>

  <div class="card" style="margin-top:12px">
    <h3>Cash (Cash Shop)</h3>
    <p class="muted">Saldo atual: <strong><%= Number(cash || 0).toLocaleString('pt-BR') %></strong> Cash</p>
    <form method="post" action="/admin/accounts/<%= account.memb___id %>/cash">
      <label>Valor</label>
      <input type="number" name="cash" min="0" max="2000000000" step="1" value="<%= Number(cash || 0) %>" required />
      <label class="checkbox">
        <input type="checkbox" name="mode" value="add" />
        Somar ao saldo atual (em vez de substituir)
      </label>
      <div class="row-between">
        <button type="submit">Atualizar Cash</button>
      </div>
    </form>
  </div>

  <form method="post" action="/admin/accounts/<%= account.memb___id %>">
    <label>Usuário</label>
    <input type="text" value="<%= account.memb___id %>" readonly />

    <label>Nome</label>
    <input type="text" name="name" value="<%= account.memb_name %>" required maxlength="10" />

    <label>E-mail</label>
    <input type="email" name="email" value="<%= account.mail_addr || '' %>" maxlength="50" />

    <label>Código (18 números)</label>
    <input type="text" name="code" value="<%= account.sno__numb %>" required maxlength="18" />

    <label>Account Level</label>
    <select name="account_level">
      <option value="0" <%= Number(account.AccountLevel) === 0 ? 'selected' : '' %>>0 - Conta normal</option>
      <option value="1" <%= Number(account.AccountLevel) === 1 ? 'selected' : '' %>>1 - VIP 1</option>
      <option value="2" <%= Number(account.AccountLevel) === 2 ? 'selected' : '' %>>2 - VIP 2</option>
      <option value="3" <%= Number(account.AccountLevel) === 3 ? 'selected' : '' %>>3 - VIP 3</option>
    </select>

    <label>Expira</label>
    <input type="datetime-local" name="account_expire" value="<%= account.AccountExpireLocal %>" />

    <label class="checkbox">
      <input type="checkbox" name="blocked" value="1" <%= account.blocked ? 'checked' : '' %> />
      Bloqueado
    </label>

    <label>Expira bloqueio</label>
    <input type="datetime-local" name="block_expire" value="<%= account.BlocExpireLocal %>" />

    <label>Nova senha (opcional)</label>
    <input type="password" name="password" maxlength="10" />

    <label>Confirmar nova senha</label>
    <input type="password" name="confirm" maxlength="10" />

    <div class="row-between">
      <button type="submit">Salvar</button>
      <a class="button-link" href="/admin/accounts">Voltar</a>
    </div>
  </form>

  <div class="card" style="margin-top:18px">
    <div class="row-between">
      <h3>Personagens</h3>
      <div class="admin-links">
        <a class="button-link" href="/admin/accounts/<%= account.memb___id %>/warehouse">Editar baú</a>
      </div>
    </div>
    <% if (!characters || characters.length === 0) { %>
      <p class="muted">Sem personagens.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Nível</th>
            <th>Resets</th>
            <th>Grand</th>
            <th>Classe</th>
            <th>Mapa</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% characters.forEach(char => { %>
            <tr>
              <td><%= char.Name %></td>
              <td><%= char.cLevel %></td>
              <td><%= char.ResetCount %></td>
              <td><%= char.GrandResetCount %></td>
              <td><%= char.ClassName %></td>
              <td><%= char.MapName %></td>
            <td class="actions">
              <a href="/admin/accounts/<%= account.memb___id %>/characters/<%= encodeURIComponent(char.Name) %>">Editar</a>
              <a href="/admin/accounts/<%= account.memb___id %>/characters/<%= encodeURIComponent(char.Name) %>/inventory">Inventário</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
      </table>
    <% } %>
  </div>

  <div class="card" style="margin-top:18px">
    <div class="row-between">
      <h3>Baú</h3>
      <div class="admin-links">
        <a class="button-link" href="/admin/accounts/<%= account.memb___id %>/warehouse">Editar</a>
        <a class="button-link" href="/admin/accounts/<%= account.memb___id %>/warehouse/editor">Editor gráfico</a>
      </div>
    </div>
    <% if (warehouse) { %>
      <ul class="list">
        <li><span>Zen</span><span><%= warehouse.Money %></span></li>
        <li><span>Senha</span><span><%= warehouse.pw %></span></li>
        <li><span>Itens (bytes)</span><span><%= warehouse.itemsBytes %></span></li>
      </ul>
    <% } else { %>
      <p class="muted">Não há baú criado para esta conta.</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>


