<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Servidor MU Online 0.97k">
  <meta name="author" content="Bloodlust">
  <meta name="theme-color" content="#0a0e15">
  <title><%= pageTitle || appName %></title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/custom.css?v=<%= assetsVersion %>">
</head>
<body class="site-body d-flex flex-column">
  <nav class="top-navbar">
    <div class="container d-flex flex-wrap align-items-center">
      <a class="navbar-brand fw-bold me-auto" href="/"><%= appName %></a>

      <button class="navbar-toggler border-0 d-block d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-expanded="false" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" class="bi" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"></path>
        </svg>
      </button>

      <div class="nav d-none d-lg-flex align-items-center">
        <% if (session && session.user) { %>
          <a class="nav-link" href="/account"><i class="bi bi-person-circle me-1"></i>Conta</a>
          <a class="nav-link" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Sair</a>
        <% } else { %>
          <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</a>
          <a class="nav-link" href="/register"><i class="bi bi-person-plus me-1"></i>Criar conta</a>
        <% } %>
      </div>
    </div>
  </nav>

  <header class="navbar navbar-expand-lg transparent-header d-none d-lg-block">
    <div class="container">
      <div class="collapse navbar-collapse justify-content-center" id="mainNav">
        <ul class="navbar-nav mb-0">
          <li class="nav-item"><a href="/" class="nav-link <%= page === 'home' ? 'active' : '' %>"><i class="bi bi-house-door me-1"></i>Início</a></li>
          <li class="nav-item"><a href="/news" class="nav-link <%= page === 'news' ? 'active' : '' %>"><i class="bi bi-newspaper me-1"></i>Notícias</a></li>
          <li class="nav-item"><a href="/rankings" class="nav-link <%= page === 'rankings' ? 'active' : '' %>"><i class="bi bi-trophy me-1"></i>Rankings</a></li>
          <li class="nav-item"><a href="/download" class="nav-link <%= page === 'download' ? 'active' : '' %>"><i class="bi bi-download me-1"></i>Downloads</a></li>
          <li class="nav-item"><a href="/shop" class="nav-link <%= page === 'shop' ? 'active' : '' %>"><i class="bi bi-cart3 me-1"></i>Cash Shop</a></li>
        </ul>
      </div>
    </div>
  </header>

  <div class="offcanvas offcanvas-start w-100" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menu</h5>
      <button type="button" class="btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>

    <div class="offcanvas-body">
      <ul class="navbar-nav">
        <li class="nav-item"><a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Início</a></li>
        <li class="nav-item"><a href="/news" class="nav-link"><i class="bi bi-newspaper me-2"></i>Notícias</a></li>
        <li class="nav-item"><a href="/rankings" class="nav-link"><i class="bi bi-trophy me-2"></i>Rankings</a></li>
        <li class="nav-item"><a href="/download" class="nav-link"><i class="bi bi-download me-2"></i>Downloads</a></li>
        <li class="nav-item"><a href="/shop" class="nav-link"><i class="bi bi-cart3 me-2"></i>Cash Shop</a></li>
      </ul>

      <div class="mt-4 d-grid gap-2">
        <% if (session && session.user) { %>
          <a class="btn btn-primary" href="/account"><i class="bi bi-person-circle me-2"></i>Minha conta</a>
          <a class="btn btn-outline-primary" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sair</a>
        <% } else { %>
          <a class="btn btn-primary" href="/login"><i class="bi bi-box-arrow-in-right me-2"></i>Entrar</a>
          <a class="btn btn-outline-primary" href="/register"><i class="bi bi-person-plus me-2"></i>Criar conta</a>
        <% } %>
      </div>
    </div>
  </div>
