<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2>Baú - <%= accountId %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts/<%= accountId %>">Conta</a>
      <a class="button-link" href="/admin/accounts">Contas</a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor">Editor servidor</a>
      <% } %>
      <a class="button-link" href="/admin/downloads">Downloads</a>
      <a class="button-link" href="/admin/logout">Sair</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <% if (!offline) { %>
    <div class="alert">A conta está online. Desconecte-a para salvar alterações.</div>
  <% } %>

  <% if (typeof conflicts !== 'undefined' && conflicts.length > 0) { %>
    <div class="alert">
      <strong>Baú com itens sobrepostos.</strong>
      <%= conflicts.length %> item(ns) ocupam o mesmo espaço que outro:
      <%= conflicts.map(function (c) { return c.name + ' (slot ' + c.slot + ')'; }).join(', ') %>.
      O jogo pode não exibir todos eles. Use <strong>Reparar baú</strong> para reorganizar
      sem alterar nenhum item.
      <form method="post" action="/admin/accounts/<%= accountId %>/warehouse/repair" style="margin-top:10px">
        <button type="submit">Reparar baú</button>
      </form>
    </div>
  <% } %>

  <div id="inventory-editor"
       data-mode="warehouse"
       data-account="<%= accountId %>"
       data-hex="<%= itemsHex %>">
  </div>

  <form method="post" action="/admin/accounts/<%= accountId %>/warehouse/editor">
    <input type="hidden" name="items_hex" id="inventory-hex" value="<%= itemsHex %>" />
    <div class="row-between">
      <button type="submit">Salvar baú</button>
      <a class="button-link" href="/admin/accounts/<%= accountId %>/warehouse">Voltar</a>
    </div>
  </form>
</section>

<script src="/js/inventory-editor.js"></script>

<%- include('partials/footer') %>


