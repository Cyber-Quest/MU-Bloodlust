<%- include('partials/site_head', { pageTitle, page }) %>

<style>
  .shop-head {
    display: flex; flex-wrap: wrap; gap: 16px;
    align-items: center; justify-content: space-between;
    margin-bottom: 18px;
  }
  .shop-head h2 { margin: 0 0 4px; font-weight: 800; }
  .shop-head p { margin: 0; opacity: .8; font-size: .95rem; }
  .shop-cash {
    display: flex; flex-direction: column; align-items: flex-end;
    padding: 10px 18px; border-radius: 12px;
    background: var(--mu-panel, #111620);
    border: 1px solid var(--mu-gold-line, rgba(224, 176, 97, .35));
  }
  .shop-cash-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
  .shop-cash-value { font-size: 1.6rem; font-weight: 800; color: var(--mu-gold, #e0b061); }

  .shop-toolbar { margin-bottom: 22px; }
  .shop-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .shop-nav a {
    font-size: .8rem; padding: 5px 12px; border-radius: 999px;
    border: 1px solid var(--mu-line, rgba(255,255,255,.12));
    color: inherit; text-decoration: none; opacity: .85;
  }
  .shop-nav a:hover { border-color: var(--mu-gold, #e0b061); color: var(--mu-gold, #e0b061); opacity: 1; }

  .shop-section { margin-bottom: 34px; scroll-margin-top: 90px; }
  .shop-section h3 {
    font-size: 1.1rem; font-weight: 700; margin-bottom: 14px;
    display: flex; align-items: center; gap: 10px;
  }
  .shop-count {
    font-size: .7rem; font-weight: 600; padding: 2px 9px; border-radius: 999px;
    background: var(--mu-panel-soft, rgba(13,17,25,.78));
    border: 1px solid var(--mu-line, rgba(255,255,255,.12)); opacity: .8;
  }

  .shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 12px; }

  .shop-item {
    display: flex; flex-direction: column;
    border-radius: 12px; overflow: hidden;
    background: var(--mu-panel, #111620);
    border: 1px solid var(--mu-line, rgba(255,255,255,.10));
    transition: transform .12s ease, border-color .12s ease;
  }
  .shop-item:hover { transform: translateY(-3px); border-color: var(--mu-gold, #e0b061); }

  .shop-item-img {
    position: relative; height: 124px; overflow: hidden;
    background: #26262d; display: flex; align-items: center; justify-content: center;
  }
  .shop-item-img img {
    max-width: 92%; max-height: 92%; width: auto; height: auto;
    object-fit: contain;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }
  .shop-item-plus {
    position: absolute; top: 5px; right: 6px;
    font-size: .62rem; font-weight: 800; padding: 2px 6px; border-radius: 6px;
    background: var(--mu-gold, #e0b061); color: #14100c;
  }

  .shop-item-name {
    font-size: .76rem; font-weight: 600; padding: 7px 8px 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .shop-item-price {
    font-size: .78rem; font-weight: 700; padding: 0 8px 8px;
    color: var(--mu-gold, #e0b061);
  }
  .shop-item-price span { font-size: .66rem; opacity: .75; }

  .shop-buy {
    width: 100%; border: 0; cursor: pointer;
    padding: 8px 6px; font-size: .78rem; font-weight: 700;
    background: linear-gradient(180deg, var(--mu-gold-bright, #f7e0a8), var(--mu-gold, #e0b061));
    color: #14100c;
  }
  .shop-buy:hover { filter: brightness(1.08); }
  .shop-empty { opacity: .7; }

  .shop-kits-hint { font-size: .85rem; opacity: .8; margin: -6px 0 14px; }
  .shop-kits { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .shop-kit {
    display: flex; flex-direction: column; border-radius: 12px; overflow: hidden;
    background: var(--mu-panel, #111620);
    border: 1px solid var(--mu-gold-line, rgba(224, 176, 97, .35));
    transition: transform .12s ease, border-color .12s ease;
  }
  .shop-kit:hover { transform: translateY(-3px); border-color: var(--mu-gold, #e0b061); }
  .shop-kit-head { display: flex; align-items: center; gap: 10px; padding: 12px 12px 8px; }
  .shop-kit-icon { width: 42px; height: 42px; object-fit: contain; }
  .shop-kit-name { font-size: .9rem; font-weight: 700; }
  .shop-kit-items { font-size: .72rem; opacity: .75; }
  .shop-kit-preview { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 12px 10px; }
  .shop-kit-preview img {
    width: 42px; height: 42px; object-fit: contain;
    background: #26262d; border-radius: 6px; padding: 2px;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }
  .shop-kit-price {
    font-size: .88rem; font-weight: 800; margin-top: auto;
    color: var(--mu-gold, #e0b061); padding: 0 12px 10px;
  }
  .shop-kit-price span { font-size: .68rem; opacity: .75; }

  .shop-head-side { display: flex; gap: 10px; flex-wrap: wrap; }
  .shop-storage {
    display: flex; flex-direction: column; align-items: flex-end;
    padding: 10px 18px; border-radius: 12px;
    background: var(--mu-panel, #111620);
    border: 1px solid var(--mu-line, rgba(255,255,255,.12));
  }
  .shop-storage-value { font-size: 1.6rem; font-weight: 800; }
  .shop-storage-value.is-full { color: #ff8f8f; }

  .shop-kit.no-fit { border-color: rgba(224, 90, 90, .55); }
  .shop-kit-nofit {
    font-size: .72rem; font-weight: 600; padding: 7px 12px;
    color: #ffb3b3; background: rgba(224, 90, 90, .12);
    border-top: 1px solid rgba(224, 90, 90, .3);
  }
  .shop-buy:disabled,
  .shop-buy--disabled {
    opacity: .5; cursor: not-allowed; filter: grayscale(.45);
  }
</style>

<main class="flex-grow-1">
  <div class="container my-5">

    <div class="shop-head">
      <div>
        <h2>Cash Shop</h2>
        <p>Todos os itens <strong>+15 completo</strong> — Excellent, Luck, Skill e Opção +28. A entrega é feita no seu <strong>baú</strong>.</p>
      </div>
      <div class="shop-head-side">
        <div class="shop-cash">
          <span class="shop-cash-label">Seu Cash</span>
          <span class="shop-cash-value"><%= Number(cash || 0).toLocaleString('pt-BR') %></span>
        </div>
        <div class="shop-storage">
          <span class="shop-cash-label">Baú livre</span>
          <span class="shop-storage-value <%= freeSlots === 0 ? 'is-full' : '' %>"><%= freeSlots %> / <%= warehouseSlots %></span>
        </div>
      </div>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice.text %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error.text %></div><% } %>

    <div class="shop-toolbar">
      <input id="shop-search" type="search" class="form-control" placeholder="Buscar item pelo nome..." autocomplete="off" />
      <div class="shop-nav">
        <% if (kits && kits.length) { %><a href="#kits">Kits por classe</a><% } %>
        <% catalog.forEach(function (group) { %>
          <a href="#sec-<%= group.section %>"><%= group.title %></a>
        <% }); %>
      </div>
    </div>

    <% if (kits && kits.length) { %>
      <section class="shop-section" id="kits">
        <h3>Kits por classe <span class="shop-count"><%= kits.length %></span></h3>
        <p class="shop-kits-hint">
          Conjunto completo (elmo, armadura, calça, luvas e botas) + arma + asas, todos <strong>+15 full</strong>.
          Os itens são entregues no seu <strong>baú</strong>.
        </p>
        <div class="shop-kits">
          <% kits.forEach(function (kit) { %>
            <div class="shop-kit <%= kit.fits ? '' : 'no-fit' %>">
              <div class="shop-kit-head">
                <img class="shop-kit-icon" src="<%= kit.icon %>" alt="<%= kit.className %>" />
                <div>
                  <div class="shop-kit-name"><%= kit.name %></div>
                  <div class="shop-kit-items"><%= kit.items.length %> itens +15 completos</div>
                </div>
              </div>
              <div class="shop-kit-preview">
                <% kit.items.forEach(function (it) { %>
                  <img src="/assets/items/<%= it.section %>/<%= it.index %>.jpg"
                       alt="<%= it.name %>" title="<%= it.name %> +15" loading="lazy"
                       onerror="this.onerror=null;this.src='/assets/inventory/unknownItem.jpg';" />
                <% }); %>
              </div>
              <div class="shop-kit-price"><%= kit.price.toLocaleString('pt-BR') %> <span>Cash</span></div>
              <% if (kit.fits) { %>
                <form method="post" action="/shop/kit/buy" data-confirm="Comprar o <%= kit.name %> por <%= kit.price.toLocaleString('pt-BR') %> Cash? Os <%= kit.items.length %> itens serão entregues no seu baú." data-confirm-title="Comprar kit" data-confirm-ok="Comprar kit">
                  <input type="hidden" name="kit" value="<%= kit.id %>" />
                  <button type="submit" class="shop-buy">Comprar kit</button>
                </form>
              <% } else { %>
                <div class="shop-kit-nofit">Sem espaço no baú para os <%= kit.items.length %> itens</div>
                <button type="button" class="shop-buy" disabled>Baú sem espaço</button>
              <% } %>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% catalog.forEach(function (group) { %>
      <section class="shop-section" id="sec-<%= group.section %>">
        <h3><%= group.title %> <span class="shop-count"><%= group.items.length %></span></h3>
        <div class="shop-grid">
          <% group.items.forEach(function (item) { %>
            <div class="shop-item" data-name="<%= item.name.toLowerCase() %>">
              <div class="shop-item-img">
                <img src="/assets/items/<%= item.section %>/<%= item.index %>.jpg"
                     alt="<%= item.name %>" loading="lazy"
                     onerror="this.onerror=null;this.src='/assets/inventory/unknownItem.jpg';" />
                <span class="shop-item-plus">+15</span>
              </div>
              <div class="shop-item-name" title="<%= item.name %>"><%= item.name %></div>
              <div class="shop-item-price"><%= item.price.toLocaleString('pt-BR') %> <span>Cash</span></div>
              <form method="post" action="/shop/buy" data-confirm="Comprar <%= item.name %> +15 por <%= item.price.toLocaleString('pt-BR') %> Cash?" data-confirm-title="Confirmar compra" data-confirm-ok="Comprar">
                <input type="hidden" name="section" value="<%= item.section %>" />
                <input type="hidden" name="index" value="<%= item.index %>" />
                <button type="submit" class="shop-buy">Comprar</button>
              </form>
            </div>
          <% }); %>
        </div>
      </section>
    <% }); %>

    <% if (!catalog.length) { %>
      <p class="shop-empty">Nenhum item disponível no momento.</p>
    <% } %>

  </div>
</main>

<script>
  (function () {
    var input = document.getElementById('shop-search');
    if (!input) return;
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      document.querySelectorAll('.shop-section').forEach(function (sec) {
        var cards = sec.querySelectorAll('.shop-item, .shop-kit');
        if (!cards.length) { sec.style.display = ''; return; }
        var any = false;
        cards.forEach(function (el) {
          var name = el.dataset.name || (el.querySelector('.shop-kit-name') || {}).textContent || '';
          var match = !q || String(name).toLowerCase().indexOf(q) !== -1;
          el.style.display = match ? '' : 'none';
          if (match) any = true;
        });
        sec.style.display = any ? '' : 'none';
      });
    });
  })();
</script>

<%- include('partials/site_footer') %>
